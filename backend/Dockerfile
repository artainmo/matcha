# Use Ruby 3.3.5 slim image
FROM ruby:3.3.5-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Gemfile (no lockfile: it isn't committed and gets generated by bundler)
COPY Gemfile ./

# Install Bundler and gems
RUN gem install bundler && bundle install

# Copy the application code
COPY . .

# Expose the port the app runs on
EXPOSE 1942

# Run bundle install again at container start: the ./backend bind mount in
# docker-compose.yml replaces /app (and any Gemfile.lock on it) at runtime,
# so this reconciles the mounted Gemfile/Gemfile.lock against the gems
# already installed in the image before starting the app.
CMD ["sh", "-c", "bundle install && bundle exec ruby myapp.rb"]
